# Database (SQLite with immutable triggers and SHA-256 audit chaining)
DATABASE_URL=sqlite:///./rm_ai.db

# AI Provider: "vertex" (Google Cloud Vertex AI), "ollama" (Local LLM), or "fake" (dev/tests)
AI_PROVIDER=vertex

# Google Cloud Vertex AI Configuration (Project: rma-app-511110)
# Express mode (API key) or custom Vertex AI Endpoint
GCP_PROJECT_ID=rma-app-511110
GCP_LOCATION=us-central1
GCP_API_KEY=
# Models available to an API key: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
VERTEX_MODEL=gemini-2.5-flash
# Custom deployed endpoint ID (if using custom-tuned Gemma 2 / 4B endpoint)
VERTEX_ENDPOINT_ID=
VERTEX_STAGING_BUCKET=gs://rma-app-511110-ml-data
# Gemini "thinking" before answering: 0 = off (about 5x faster on long documents), empty = model default
VERTEX_THINKING_BUDGET=0

# Ollama local air-gapped configuration
OLLAMA_URL=http://localhost:11434
# Exact tag from `ollama list` on the model server (team plan: Gemma 4B; confirm the tag)
OLLAMA_MODEL=gemma4:e4b-rmi
# Only for a remote Ollama behind an auth proxy; leave empty for local Ollama
OLLAMA_API_KEY=
AI_TIMEOUT_SECONDS=300

# Security and Boundaries
MAX_INPUT_CHARS=20000
CONFIDENCE_REVIEW_THRESHOLD=0.7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Optional: allow every address matching a pattern, e.g. all Vercel deploys
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
