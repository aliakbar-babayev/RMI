# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=sqlite:///./rm_ai.db

# ollama = local model; vertex = Google Cloud Vertex AI; fake = no model (for frontend work)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Exact tag from `ollama list` on the model server (team plan: Gemma 4B; confirm the tag)
OLLAMA_MODEL=gemma4:e4b
# Only for a remote Ollama behind an auth proxy; leave empty for local Ollama
OLLAMA_API_KEY=

# Google Cloud Vertex AI (AI_PROVIDER=vertex). Put the real key only in .env, never here.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_API_KEY=
# Models available to an API key: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
# (Gemma on Vertex needs its own deployed endpoint and is not reachable with an API key.)
VERTEX_MODEL=gemini-2.5-flash
# Gemini "thinking" before answering: 0 = off (about 5x faster on long documents), empty = model default
VERTEX_THINKING_BUDGET=0

AI_TIMEOUT_SECONDS=300

MAX_INPUT_CHARS=20000
CONFIDENCE_REVIEW_THRESHOLD=0.7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
