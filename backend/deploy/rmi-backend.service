# systemd unit: keeps the RMI backend running and restarts it after crashes or reboots.
# Installed by setup.sh to /etc/systemd/system/rmi-backend.service
[Unit]
Description=RMI backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=rmi
Group=rmi
WorkingDirectory=__APP_DIR__/backend
# One worker on purpose: the audit chain's write lock and SQLite need a single process.
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3
# Basic hardening: the service can only write inside the app folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__APP_DIR__/backend

[Install]
WantedBy=multi-user.target
